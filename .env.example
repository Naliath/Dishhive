# Copy this file to ".env" and fill in your values. ".env" is gitignored.
# These variables feed docker-compose interpolation (${AI_*}) for the app's Ai__* settings.
# Anything left unset falls back to the committed defaults in docker-compose.yml (local LM Studio).

# Provider: openai | anthropic | mistral | ollama | lmstudio | openai-compatible
AI_PROVIDER=openai-compatible

# API key for cloud providers. openai-compatible (e.g. OpenRouter) needs it here;
# openai/anthropic/mistral also accept their standard OPENAI_API_KEY / ANTHROPIC_API_KEY /
# MISTRAL_API_KEY env vars instead.
AI_API_KEY=sk-...

# Endpoint (required for openai-compatible; overrides the per-provider default otherwise)
AI_BASE_URL=https://openrouter.ai/api/v1

# Model id
AI_MODEL=deepseek/deepseek-v4-flash

# Optional tuning — omit to use the built-in defaults (0.3 / 1 / 6000)
# AI_TEMPERATURE=0.3
# AI_MAX_RETRIES=1
# AI_MAX_PROMPT_TOKENS=20000

# Agentic (web-search) path only — omit to use the built-in defaults (300 / 8).
# Raise AI_AGENT_TIMEOUT_SECONDS if suggestions with @[Source] keep falling back to
# the rules engine after a while (check the logs for "AI suggestion call failed");
# a slow model or a chatty tool loop can outrun the default budget.
# AI_AGENT_TIMEOUT_SECONDS=300
# AI_MAX_TOOL_ITERATIONS=8

# ---------------------------------------------------------------------------
# Web search — lets the AI planner find & import NEW recipes from the web
# (e.g. "vegetarian under 30 min from @[Dagelijkse Kost]"). Requires a
# tool-capable model. Enabled by default in docker-compose against the bundled
# "searxng" service (host UI at http://localhost:5102); uncomment below only
# to override the defaults.
# ---------------------------------------------------------------------------
# Provider: searxng (self-hosted; the only provider implemented so far)
# WEBSEARCH_PROVIDER=searxng
# BaseUrl of the search backend (the app reaches the bundled service at http://searxng:8080)
# WEBSEARCH_BASE_URL=http://searxng:8080
# Max results returned to the model per query
# WEBSEARCH_MAX_RESULTS=5
