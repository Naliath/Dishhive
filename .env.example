# Copy this file to ".env" and fill in your values. ".env" is gitignored.
# These variables feed docker-compose interpolation (${AI_*}) for the app's Ai__* settings.
# Anything left unset falls back to the committed defaults in docker-compose.yml (local LM Studio).

# Provider: openai | anthropic | mistral | ollama | lmstudio | openai-compatible
AI_PROVIDER=openai-compatible

# API key for cloud providers. openai-compatible (e.g. OpenRouter) needs it here;
# openai/anthropic/mistral also accept their standard OPENAI_API_KEY / ANTHROPIC_API_KEY /
# MISTRAL_API_KEY env vars instead.
AI_API_KEY=sk-...

# Endpoint (required for openai-compatible; overrides the per-provider default otherwise)
AI_BASE_URL=https://openrouter.ai/api/v1

# Model id
AI_MODEL=deepseek/deepseek-v4-flash

# Optional tuning — omit to use the built-in defaults (0.3 / 1 / 6000)
# AI_TEMPERATURE=0.3
# AI_MAX_RETRIES=1
# AI_MAX_PROMPT_TOKENS=20000
