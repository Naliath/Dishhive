# Copy this file to ".env" and fill in your values. ".env" is gitignored.
# These variables feed docker-compose interpolation (${AI_*}) for the app's Ai__* settings.
# Anything left unset falls back to the committed defaults in docker-compose.yml (local LM Studio).

# Application minimum log level inside the app container. Information is the compose
# default; use Debug temporarily to include raw AI responses, or Warning to reduce logs.
# LOG_LEVEL=Debug

# Provider (all OpenAI-compatible): openai | mistral | ollama | lmstudio | openai-compatible
AI_PROVIDER=openai-compatible

# API key for cloud providers. openai-compatible (e.g. OpenRouter) needs it here;
# openai/mistral also accept their standard OPENAI_API_KEY / MISTRAL_API_KEY env
# vars instead.
AI_API_KEY=sk-...

# Endpoint (required for openai-compatible; overrides the per-provider default otherwise)
AI_BASE_URL=https://openrouter.ai/api/v1

# Model id
AI_MODEL=deepseek/deepseek-v4-flash

# Shared execution tuning. The central AI gate applies these values to all tasks,
# with the task-specific output caps below. Omit to use the built-in defaults.
# AI_MAX_OUTPUT_TOKENS=12000
# AI_TIMEOUT_SECONDS=60
# AI_DISABLE_THINKING=true
# AI_TEMPERATURE=0.3
# AI_MAX_RETRIES=1
# AI_MAX_PROMPT_TOKENS=20000
# AI_FACTS_MAX_OUTPUT_TOKENS=512
# AI_TRANSLATION_MAX_OUTPUT_TOKENS=8000
# AI_TRANSLATION_MAX_PROMPT_TOKENS=12000
# AI_IMPORT_MAX_OUTPUT_TOKENS=6000
# AI_IMPORT_MAX_PROMPT_TOKENS=24000

# Week planning with deterministic web search uses a longer end-to-end timeout.
# Raise AI_AGENT_TIMEOUT_SECONDS if suggestions with @[Source] keep falling back to
# the rules engine after a while (check the logs for "AI suggestion call failed");
# a slow model plus recipe search and verification can outrun the default budget.
# AI_AGENT_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Web search — lets the AI planner find & import NEW recipes from the web
# (e.g. "vegetarian under 30 min from @[Dagelijkse Kost]"). Requires a
# Enabled by default in docker-compose against the bundled
# "searxng" service (host UI at http://localhost:5102); uncomment below only
# to override the defaults.
# ---------------------------------------------------------------------------
# Provider: searxng (self-hosted; the only provider implemented so far)
# WEBSEARCH_PROVIDER=searxng
# BaseUrl of the search backend (the app reaches the bundled service at http://searxng:8080)
# WEBSEARCH_BASE_URL=http://searxng:8080
# Max results returned to the model per query
# WEBSEARCH_MAX_RESULTS=5
