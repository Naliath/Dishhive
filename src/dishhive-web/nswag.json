{
  "runtime": "Net100",
  "defaultVariables": "ApiSpecPath=../Dishhive.Api/openapi/Dishhive.Api.json",
  "documentGenerator": {
    "fromDocument": {
      "url": "$(ApiSpecPath)",
      "newLineBehavior": "Auto"
    }
  },
  "codeGenerators": {
    "openApiToTypeScriptClient": {
      "className": "{controller}Client",
      "template": "Angular",
      "useBaseUrl": false,
      "baseUrl": "",
      "httpClass": "HttpClient",
      "injectionTokenType": "InjectionToken",
      "rxJsVersion": 7.0,
      "nullValue": "Null",
      "dateTimeType": "string",
      "operationGenerationMode": "MultipleClientsFromOperationId",
      "generateClientInterfaces": true,
      "generateClientClasses": true,
      "useSingletonProvider": true,
      "typeStyle": "Interface",
      "generateOptionalParameters": true,
      "exportTypes": true,
      "output": "src/app/api/generated/dishhive-api.client.ts",
      "newLineBehavior": "Auto"
    }
  }
}
