{
  "name": "dishhive",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run sync-version && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "sync-version": "node scripts/sync-version.js",
    "generate:api-client": "dotnet build ../Dishhive.Api/Dishhive.Api.csproj --no-restore && dotnet tool restore && dotnet nswag run nswag.json && node scripts/normalize-generated-client.mjs",
    "check:api-client": "npm run generate:api-client && git diff --exit-code -- src/app/api/generated/dishhive-api.client.ts ../Dishhive.Api/openapi/Dishhive.Api.json",
    "test:browser": "playwright test",
    "check:browser-fixtures": "tsc -p e2e/tsconfig.json",
    "check:localization": "node scripts/check-localization.mjs",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.23",
    "@angular/cdk": "~21.1.1",
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/material": "~21.1.1",
    "@angular/platform-browser": "^21.2.23",
    "@angular/router": "^21.2.23",
    "@angular/service-worker": "^21.2.23",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.23",
    "@playwright/test": "^1.63.0",
    "jsdom": "^27.1.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
